#!/usr/bin/env lua

-- genpuin — run a genpuin art script and export the result
--
-- Usage:
--   genpuin script.lua                outputs ./script.svg
--   genpuin script.lua -o out.svg     outputs to explicit path
--   genpuin script.lua -o out.ppm     PPM output (inferred from extension)
--   genpuin script.lua -o x.ppm -s 2  PPM with 2x scale

-- Check Lua version
local major, minor = _VERSION:match("Lua (%d+)%.(%d+)")
if not major or tonumber(major) < 5 or (tonumber(major) == 5 and tonumber(minor) < 4) then
    io.stderr:write("genpuin requires Lua 5.4 or later (found " .. _VERSION .. ")\n")
    os.exit(1)
end

-- Resolve library path
local scriptDir = arg[0]:match("(.+)/[^/]+$") or "."
local libDir = scriptDir .. "/../share/lua/5.4"
local devDir = scriptDir .. "/.."

package.path = libDir .. "/?.lua;" .. libDir .. "/?/init.lua;"
             .. devDir .. "/?.lua;" .. devDir .. "/?/init.lua;"
             .. package.path

-- Parse arguments
local scriptPath
local outputPath
local scale

local i = 1
while i <= #arg do
    local a = arg[i]
    if a == "-o" then
        i = i + 1
        outputPath = arg[i]
        if not outputPath then
            io.stderr:write("error: -o requires an argument\n")
            os.exit(1)
        end
    elseif a == "-s" then
        i = i + 1
        scale = tonumber(arg[i])
        if not scale then
            io.stderr:write("error: -s requires a number\n")
            os.exit(1)
        end
    elseif a == "-h" or a == "--help" then
        print("Usage: genpuin <script.lua> [-o output] [-s scale]")
        print()
        print("  <script.lua>   Lua script that returns a genpuin canvas")
        print("  -o <file>      Output file (default: <basename>.svg in current dir)")
        print("                 Format inferred from extension (.svg or .ppm)")
        print("  -s <number>    Scale factor for PPM output (default: 1)")
        print("  -h, --help     Show this help")
        os.exit(0)
    elseif a:sub(1, 1) == "-" then
        io.stderr:write("error: unknown option: " .. a .. "\n")
        os.exit(1)
    else
        if scriptPath then
            io.stderr:write("error: unexpected argument: " .. a .. "\n")
            os.exit(1)
        end
        scriptPath = a
    end
    i = i + 1
end

if not scriptPath then
    io.stderr:write("Usage: genpuin <script.lua> [-o output] [-s scale]\n")
    os.exit(1)
end

-- Load and run the user script
local fn, err = loadfile(scriptPath)
if not fn then
    io.stderr:write(err .. "\n")
    os.exit(1)
end

local canvas = fn()

-- Export if script returned a canvas
if canvas and type(canvas) == "table" and canvas.width then
    if not outputPath then
        local base = scriptPath:match("([^/]+)%.lua$") or "output"
        outputPath = base .. ".svg"
    end

    local ext = outputPath:match("%.(%w+)$")
    if ext == "ppm" then
        local ppm = require("genpuin.ppm")
        ppm.exportPpm(canvas, outputPath, scale)
    else
        local svg = require("genpuin.svg")
        svg.exportSvg(canvas, outputPath)
    end

    print("Wrote " .. outputPath)
end
